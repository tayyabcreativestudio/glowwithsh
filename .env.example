# ====================================================
# GLOWWITHSH — PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================
# IMPORTANT: Never commit actual secrets or production values to version control.
# Copy this file to .env and populate with secure, unguessable production values.

# ----------------------------------------------------
# SERVER & NETWORK
# ----------------------------------------------------
PORT=3000
NODE_ENV=production
# Authoritative canonical URL of the deployed application (used for CORS and webhook verification)
APP_URL=https://www.glowwithsh.com
ADMIN_URL=https://admin.glowwithsh.com

# ----------------------------------------------------
# ADMIN AUTHENTICATION & SESSION SECURITY (MANDATORY)
# ----------------------------------------------------
# 32+ character high-entropy cryptographically random secret used to sign admin session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production startup will FAIL if this secret is missing or under 32 characters.
ADMIN_AUTH_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET

# The unique username for the administrative account.
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME

# Strong, high-entropy initial master password for first-time database provisioning.
# NEVER leave this blank or set to a default password in production.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNGUESSABLE_PASSWORD

# Registered GSTIN used on tax invoices. Verify it before enabling checkout.
SITE_GSTIN=REPLACE_WITH_VALID_GSTIN

# ----------------------------------------------------
# ONLINE PAYMENT GATEWAY — RAZORPAY (MANDATORY FOR ONLINE PAYMENTS)
# ----------------------------------------------------
# In production, Razorpay LIVE keys MUST be provided.
# The server will automatically REFUSE startup with rzp_test_* keys when NODE_ENV=production.
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_KEY_SECRET
# Webhook secret configured in your Razorpay Dashboard under Webhooks
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET

# Transactional order confirmation email (Resend)
# Verify the sending domain in Resend before using this address.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
ORDER_EMAIL_FROM="GlowWithSH <orders@your-domain.com>"

# ----------------------------------------------------
# PRODUCTION DATABASE (POSTGRESQL)
# ----------------------------------------------------
# Connection string for production PostgreSQL instance.
# Required for persistent, ACID-compliant multi-container deployment.
# Run migrations using: npm run db:migrate
DATABASE_URL=postgresql://gwsh_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/glowwithsh_db?sslmode=require

# ----------------------------------------------------
# CONCIERGE & BUSINESS COMMUNICATION
# ----------------------------------------------------
# WhatsApp business concierge number (country code + 10 digits without spaces or leading +)
WHATSAPP_NUMBER=917303490594
SUPPORT_EMAIL=care@glowwithsh.com
GRIEVANCE_EMAIL=grievance@glowwithsh.com

# ----------------------------------------------------
# AI STUDIO / GEMINI (SERVER-SIDE ONLY)
# ----------------------------------------------------
# Optional API key for server-side concierge recommendations.
# Kept strictly server-side. Never expose via VITE_* prefixes.
GEMINI_API_KEY=
