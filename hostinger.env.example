# Paste these as individual Environment Variables in Hostinger hPanel.
# Replace every value in angle brackets. Do not commit a real .env file.

NODE_ENV=production
PORT=3000
APP_URL=https://www.glowwithsh.com
ADMIN_URL=https://admin.glowwithsh.com
# Hostinger subdomains can use a separate static folder. Enable this to use
# the deployed Node.js app's admin console at https://www.glowwithsh.com/admin.
ADMIN_SAME_ORIGIN=true

# Ask Hostinger Support for a persistent writable location outside hbuilds/ and public_html.
DATA_DIR=<HOSTINGER_PERSISTENT_PATH>/glowwithsh/data
UPLOADS_DIR=<HOSTINGER_PERSISTENT_PATH>/glowwithsh/uploads

ADMIN_USERNAME=<YOUR_PRIVATE_ADMIN_USERNAME>
ADMIN_PASSWORD=<YOUR_NEW_LONG_UNIQUE_ADMIN_PASSWORD>
ADMIN_AUTH_SECRET=<GENERATE_A_64_CHARACTER_RANDOM_SECRET>

# Required for a real production launch of this project.
SITE_GSTIN=<YOUR_VALID_GSTIN>
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=<YOUR_RAZORPAY_LIVE_KEY_ID>
RAZORPAY_KEY_SECRET=<YOUR_RAZORPAY_LIVE_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<YOUR_RAZORPAY_WEBHOOK_SECRET>

WHATSAPP_NUMBER=917303490594
SUPPORT_EMAIL=care@glowwithsh.com
GRIEVANCE_EMAIL=grievance@glowwithsh.com

# Optional: leave empty if you are not using the AI SEO suggestion tool.
GEMINI_API_KEY=
GEMINI_SEO_MODEL=gemini-3.5-flash-lite
